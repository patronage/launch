# Settings for `pnpm db:pull` (packages/db-pull/pull-postgres.sh), which copies
# the content of the PlanetScale database behind production's Hyperdrive into
# the local Postgres from docker-compose.yml. Read, never evaluated.
PSCALE_ORG=sysadmin-patronage
PSCALE_DATABASE=launch-payload
PSCALE_BRANCH=main
PG_MAJOR=17
TARGET_URL=postgres://postgres:postgres@localhost:5437/launch_payload
DELETE_COMMAND=pnpm db:recreate
AFTER_SCRIPT=scripts/db-pull-after.mjs
