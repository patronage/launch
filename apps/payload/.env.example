# Copy to .env (Payload CLI) and .dev.vars (vite dev / preview).
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Only for PAYLOAD_DB=postgres. The local Postgres from `pnpm db` (Hyperdrive needs a password), used by Hyperdrive in dev and by the CLI.
POSTGRES_URL=postgres://postgres:postgres@localhost:5437/launch_payload
