{
  "name": "@launch/payload",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.mjs",
    "payload": "cross-env NODE_OPTIONS=\"--no-deprecation --import=./scripts/register-node-hooks.mjs\" payload",
    "typecheck": "cf workers types && tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "generate": "pnpm payload generate:types && pnpm payload generate:importmap",
    "seed": "pnpm payload run scripts/seed.ts",
    "record-fixture": "pnpm payload run scripts/record-fixture.ts",
    "db": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:recreate": "docker compose down --volumes && docker compose up -d --wait",
    "db:pull": "launch-db-pull",
    "migrate:create": "node scripts/migrate-create.mjs",
    "d1:copy": "node scripts/d1-to-postgres.mjs",
    "hyperdrive:configure": "node scripts/hyperdrive.mjs",
    "secrets": "node scripts/secrets.mjs",
    "builds:configure": "node scripts/workers-builds.mjs",
    "test": "vitest run && node --test scripts/config-startup.test.mjs scripts/db-pull-tables.test.mjs scripts/d1-to-postgres.test.mjs scripts/hyperdrive.test.mjs scripts/preview-schema.test.mjs scripts/migrate-create.test.mjs"
  },
  "dependencies": {
    "@launch/adapter-payload": "workspace:*",
    "@launch/content-model": "workspace:*",
    "@launch/images": "workspace:*",
    "@launch/ui": "workspace:*",
    "@noble/hashes": "2.4.0",
    "@patronage/access": "workspace:*",
    "@patronage/logging": "workspace:*",
    "@payloadcms/db-d1-sqlite": "4.0.0-beta.8",
    "@payloadcms/db-postgres": "4.0.0-beta.8",
    "@payloadcms/live-preview-react": "4.0.0-beta.8",
    "@payloadcms/next": "4.0.0-beta.8",
    "@payloadcms/plugin-form-builder": "4.0.0-beta.8",
    "@payloadcms/plugin-mcp": "4.0.0-beta.8",
    "@payloadcms/plugin-nested-docs": "4.0.0-beta.8",
    "@payloadcms/plugin-redirects": "4.0.0-beta.8",
    "@payloadcms/plugin-seo": "4.0.0-beta.8",
    "@payloadcms/richtext-lexical": "4.0.0-beta.8",
    "@payloadcms/storage-r2": "4.0.0-beta.8",
    "@payloadcms/ui": "4.0.0-beta.8",
    "@vinext/cloudflare": "1.3.4",
    "graphql": "16.15.0",
    "next": "16.4.6",
    "payload": "4.0.0-beta.8",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.16",
    "@launch/db-pull": "workspace:*",
    "@launch/demo-content": "workspace:*",
    "@launch/worker-scripts": "workspace:*",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "catalog:",
    "@types/pg": "8.20.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "cf": "1.0.0-beta.31",
    "cross-env": "10.1.0",
    "jose": "6.2.17",
    "miniflare": "5.20261023.2-beta",
