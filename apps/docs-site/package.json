{
  "name": "docs-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/publish-notes.mjs && blume dev",
    "build": "node scripts/publish-notes.mjs && blume build",
    "start": "blume preview",
    "test": "node scripts/publish-notes.mjs && blume validate --strict",
    "typecheck": "tsc --noEmit",
    "deploy": "node scripts/deploy.mjs",
    "builds:configure": "node scripts/workers-builds.mjs"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.9.6",
    "@cloudflare/config": "0.29.0",
    "@types/node": "catalog:",
    "blume": "2.2.6",
    "cf": "1.0.0-beta.25",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
