---
/**
 * The document around every page: fonts, the shared stylesheet, EmDash's SEO
 * head (meta description, robots, canonical, Open Graph, Twitter cards and
 * JSON-LD, with the entry's SEO panel overlaid), and the site title, tagline
 * and `primary` menu.
 */
import { FontLinks } from "@launch/ui";
import { getMenu, getSiteSettings } from "emdash";
import { createPublicPageContext } from "emdash/page";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";

import { SiteChrome } from "../components/site-chrome";
import type { NavItem } from "../components/site-chrome";
import "../styles/global.css";

interface Props {
  /** The page's own title; the home page leaves it out. */
  title?: string | undefined;
  description?: string | undefined;
  /** The content entry this page renders, so its SEO panel applies. */
  content?: { collection: string; id: string; slug: string } | undefined;
}

const { title, description, content } = Astro.props;

const [settings, primary] = await Promise.all([
  getSiteSettings(),
  getMenu("primary"),
]);

const siteTitle = settings.title || "Launch";
const tagline = settings.tagline || undefined;

const menu: NavItem[] = (primary?.items ?? []).map((item) => ({
  href: item.url,
  id: item.id,
  label: item.label,
  newTab: item.target === "_blank",
}));

const documentTitle = title ? `${title} | ${siteTitle}` : siteTitle;

// The site URL setting, else the request's origin. Query strings, preview
// tokens included, never reach the canonical URL.
const siteUrl = settings.url || Astro.url.origin;

const page = createPublicPageContext({
  Astro,
  canonical: content ? new URL(Astro.url.pathname, siteUrl).href : null,
  content,
  description: description ?? tagline ?? null,
  kind: content ? "content" : "custom",
  pageTitle: title ?? siteTitle,
  pageType: "website",
  siteName: siteTitle,
  siteUrl,
  title: documentTitle,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <EmDashHead page={page} />
    <FontLinks />
  </head>
  <body class="flex min-h-svh flex-col">
    <EmDashBodyStart page={page} />
    <SiteChrome siteTitle={siteTitle} tagline={tagline} menu={menu}>
      <slot />
    </SiteChrome>
    <EmDashBodyEnd page={page} />
  </body>
</html>
