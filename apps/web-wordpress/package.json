{
  "name": "web-wordpress",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm codegen && vite dev --port 3000",
    "build": "pnpm codegen && vite build",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:schema": "pnpm --filter cms-wordpress-headless schema && pnpm codegen",
    "typecheck": "pnpm codegen && cf workers types && tsc --noEmit",
    "test": "pnpm codegen && vitest run && node scripts/documents.ts --check",
    "documents": "pnpm codegen && node scripts/documents.ts",
    "deploy": "node scripts/deploy.mjs",
    "secrets": "node scripts/secrets.mjs",
    "builds:configure": "node scripts/workers-builds.mjs"
  },
  "dependencies": {
    "@launch/adapter-wordpress": "workspace:*",
    "@launch/content-model": "workspace:*",
    "@launch/images": "workspace:*",
    "@launch/ui": "workspace:*",
    "@patronage/access": "workspace:*",
    "@patronage/logging": "workspace:*",
    "@vinext/cloudflare": "1.3.0",
    "graphql": "17.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.7",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@graphql-typed-document-node/core": "3.2.0",
    "@launch/worker-scripts": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "cf": "1.0.0-beta.25",
    "jose": "6.2.14",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
