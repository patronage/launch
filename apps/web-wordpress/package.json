{
  "name": "web-wordpress",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm codegen && vite dev --port 3000",
    "build": "pnpm codegen && vite build",
    "start": "vinext start --port 3000",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:schema": "pnpm --filter cms-wordpress-headless schema && pnpm codegen",
    "typecheck": "pnpm codegen && tsc --noEmit",
    "test": "pnpm codegen && vitest run && node scripts/documents.ts --check",
    "documents": "pnpm codegen && node scripts/documents.ts"
  },
  "dependencies": {
    "graphql": "17.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@graphql-typed-document-node/core": "3.2.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
