# apps/cms-wordpress-headless/bin/setup.sh writes .env.local with these filled in.
WORDPRESS_URL=http://localhost:8080
# Shared with WordPress: verifies preview links and authenticates revalidation.
HEADLESS_SECRET=
# An application password for a WordPress editor, used only to read drafts in preview.
WORDPRESS_PREVIEW_USER=
WORDPRESS_PREVIEW_PASSWORD=
# Production CMS requests pass through Cloudflare Access. Leave empty locally.
WORDPRESS_ACCESS_CLIENT_ID=
WORDPRESS_ACCESS_CLIENT_SECRET=
WORDPRESS_ACCESS_PROOF_SECRET=
ACCESS_TEAM_DOMAIN=
ACCESS_PREVIEW_AUD=
