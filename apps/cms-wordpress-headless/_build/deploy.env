# Deploy settings for this site, read by _build/deploy.sh. Committed and non-secret.
# .env and the environment override these. _build/deploy.env.sample documents
# every setting.
#
# This repo is public, so the Cloudways server IPs, application paths and SSH
# users go in .env (gitignored, next to _build/), not here. .env.example lists them.

# `bash _build/deploy.sh staging` deploys to cloudways-staging.
DEPLOY_HOST=cloudways

# Branch the Cloudways hook installs. install-hook writes it to the server.
DEPLOY_REMOTE_BRANCH=main

# Production plugins from composer.lock and the shared Access mu-plugin. Its
# output is gitignored and added by the include list.
DEPLOY_BUILD_TASK=bin/build.sh

DEPLOY_INCLUDE_FILE=_build/.deploy_include.txt
DEPLOY_EXCLUDE_FILE=_build/.deploy_exclude.txt

# `bash _build/pull.sh import` loads a dump into the local Docker database
# (service db, database, user and password wordpress: the defaults), then this
# points the URLs at local Docker and refreshes the preview editor's password.
PULL_IMPORT_TASK=bin/after-import.sh
