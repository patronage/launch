{
  "name": "patronage/launch-cms-wordpress-headless",
  "description": "Headless WordPress for the Launch vinext front-end. Plugins and libraries are installed by Composer and never committed.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "composer/installers": "2.3.0",
    "wp-graphql/wp-graphql": "2.25.0",
    "wp-graphql/wp-graphql-acf": "3.0.0",
    "wordpress/secure-custom-fields": "6.9.7",
    "wp-graphql/wp-graphql-smart-cache": "2.3.4",
    "vinkla/extended-acf": "14.6.2"
  },
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "wp-graphql/wp-graphql",
        "version": "2.25.0",
        "type": "wordpress-plugin",
        "dist": {
          "type": "zip",
          "url": "https://github.com/wp-graphql/wp-graphql/releases/download/wp-graphql%2Fv2.25.0/wp-graphql.zip"
        },
        "require": {
          "composer/installers": "^2.2"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "wp-graphql/wp-graphql-acf",
        "version": "3.0.0",
        "type": "wordpress-plugin",
        "dist": {
          "type": "zip",
          "url": "https://github.com/wp-graphql/wp-graphql/releases/download/wp-graphql-acf%2Fv3.0.0/wp-graphql-acf.zip"
        },
        "require": {
          "composer/installers": "^2.2"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "wp-graphql/wp-graphql-smart-cache",
        "version": "2.3.4",
        "type": "wordpress-plugin",
        "dist": {
          "type": "zip",
          "url": "https://github.com/wp-graphql/wp-graphql/releases/download/wp-graphql-smart-cache%2Fv2.3.4/wp-graphql-smart-cache.zip"
        },
        "require": {
          "composer/installers": "^2.2"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "wordpress/secure-custom-fields",
        "version": "6.9.7",
        "type": "wordpress-plugin",
        "dist": {
          "type": "zip",
          "url": "https://github.com/WordPress/secure-custom-fields/releases/download/6.9.7/secure-custom-fields.zip"
        },
        "require": {
          "composer/installers": "^2.2"
        }
      }
    }
  ],
  "config": {
    "vendor-dir": "wp-content/plugins/composer-libs",
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true
    },
    "platform": {
      "php": "8.3"
    }
  },
  "extra": {
    "installer-paths": {
      "wp-content/plugins/{$name}/": [
        "type:wordpress-plugin"
      ]
    }
  }
}
