{
  "name": "patronage/launch-cms-wordpress-headless",
  "description": "Headless WordPress for the Launch vinext front-end. Plugins are installed by Composer and never committed.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "composer/installers": "2.3.0",
    "wp-graphql/wp-graphql": "2.25.0",
    "wp-graphql/wp-graphql-acf": "3.0.0",
    "wpengine/advanced-custom-fields": "6.8.10"
  },
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "wp-graphql/wp-graphql",
        "version": "2.25.0",
        "type": "wordpress-plugin",
        "dist": {
          "type": "zip",
          "url": "https://github.com/wp-graphql/wp-graphql/releases/download/wp-graphql%2Fv2.25.0/wp-graphql.zip"
        },
        "require": {
          "composer/installers": "^2.2"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "wp-graphql/wp-graphql-acf",
        "version": "3.0.0",
        "type": "wordpress-plugin",
        "dist": {
          "type": "zip",
          "url": "https://github.com/wp-graphql/wp-graphql/releases/download/wp-graphql-acf%2Fv3.0.0/wp-graphql-acf.zip"
        },
        "require": {
          "composer/installers": "^2.2"
        }
      }
    },
    {
      "type": "vcs",
      "url": "https://github.com/AdvancedCustomFields/acf",
      "no-api": true
    }
  ],
  "config": {
    "vendor-dir": "wp-content/plugins/composer-libs",
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true
    },
    "platform": {
      "php": "8.3"
    }
  },
  "extra": {
    "installer-paths": {
      "wp-content/plugins/{$name}/": [
        "type:wordpress-plugin"
      ]
    }
  }
}
