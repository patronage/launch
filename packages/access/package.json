{
  "name": "@patronage/access",
  "version": "0.2.0",
  "description": "Cloudflare Access helpers: verify Access JWTs, call Access-protected origins with a service token, bind forwarded JWTs with a gateway proof, and provision Access through the Cloudflare API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patronage/launch.git",
    "directory": "packages/access"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./payload": "./src/payload.ts",
    "./cloudflare": "./src/cloudflare-api.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./payload": {
        "types": "./dist/payload.d.ts",
        "default": "./dist/payload.js"
      },
      "./cloudflare": {
        "types": "./dist/cloudflare-api.d.ts",
        "default": "./dist/cloudflare-api.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "access:provision": "node scripts/provision-access.ts",
    "build": "tsdown",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "6.2.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "0.23.4",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
