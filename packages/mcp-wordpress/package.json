{
  "name": "@patronage/mcp-wordpress",
  "version": "0.3.1",
  "description": "The WordPress connector for @patronage/mcp-core: WPGraphQL and REST reads, and post updates through the approval step.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patronage/launch.git",
    "directory": "packages/mcp-wordpress"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm --filter @patronage/mcp-core generate && tsdown",
    "prepack": "pnpm build",
    "test": "pnpm --filter @patronage/mcp-core generate && vitest run",
    "typecheck": "pnpm --filter @patronage/mcp-core generate && tsc --noEmit"
  },
  "dependencies": {
    "@patronage/mcp-core": "workspace:*",
    "graphql": "17.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "@patronage/access": "workspace:*",
    "@types/node": "catalog:",
    "evlog": "2.26.0",
    "tsdown": "0.23.4",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
