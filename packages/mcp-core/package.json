{
  "name": "@patronage/mcp-core",
  "version": "0.2.0",
  "description": "An MCP gateway Worker for Cloudflare: Access sign-in, code mode over CMS connectors, and a human approval step before every write.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patronage/launch.git",
    "directory": "packages/mcp-core"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm generate && tsdown",
    "generate": "node scripts/build-approval-card.mjs",
    "prepack": "pnpm build",
    "test": "pnpm generate && vitest run",
    "typecheck": "pnpm generate && tsc --noEmit && tsc --noEmit -p src/approval-card"
  },
  "dependencies": {
    "@cloudflare/codemode": "0.5.1",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@patronage/access": "workspace:*",
    "agents": "0.21.0",
    "evlog": "2.26.0",
    "jose": "6.2.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "tsdown": "0.23.4",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
