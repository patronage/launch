  "homepage": "https://launch.patronage.com/references/wordpress-plugins",
  "authors": [
    {
      "name": "Patronage",
      "homepage": "https://patronage.org"
    }
  ],
  "support": {
    "source": "https://github.com/patronage/launch/tree/main/wordpress-shared/patronage-fleet",
