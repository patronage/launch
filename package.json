{
  "name": "launch",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "deps:check": "pnpm exec taze -r -l",
    "deps:major": "pnpm exec taze major -r -l",
    "deps:update": "pnpm exec taze minor -r -l -w",
    "deps:verify": "CI=true pnpm install --frozen-lockfile",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "test": "pnpm -r --if-present run test && node --test .agents/skills/launch-verify/scripts/verify.test.ts",
    "typecheck": "pnpm -r --if-present run typecheck",
    "verify": "pnpm deps:verify && pnpm lint && pnpm typecheck && pnpm test",
    "wp:release": "node wordpress-shared/plugin-release/release.ts"
  },
  "devDependencies": {
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "taze": "21.3.0",
    "typescript": "7.0.2",
    "ultracite": "8.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1"
}
